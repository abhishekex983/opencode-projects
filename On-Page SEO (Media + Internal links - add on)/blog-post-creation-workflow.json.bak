    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Normalize inputs for the blog-post-tldr webhook.\nconst input = $input.first().json;\nconst form = (input && typeof input.body === 'object' && input.body !== null && Object.keys(input.body).length > 0)\n  ? input.body\n  : input;\n\nconst norm = s => String(s).toLowerCase().replace(/[^a-z0-9]/g, '');\nconst pick = (...keys) => {\n  for (const k of keys) {\n    if (form[k] !== undefined && form[k] !== null && form[k] !== '') return form[k];\n  }\n  const targets = keys.map(norm);\n  for (const k of Object.keys(form)) {\n    const n = norm(k);\n    if (targets.some(t => n === t || n.startsWith(t))) return form[k];\n  }\n  return '';\n};\n\nif (!form.content && !form.edited_outline) {\n  return [{ json: { error: 'content is required (the blog post markdown).' } }];\n}\n\nreturn [{\n  json: {\n    topic: pick('topic', 'Topic') || '',\n    focus_keyword: pick('focus_keyword', 'Focus Keyword', 'focusKeyword') || '',\n    content: form.content || form.edited_outline || ''\n  }\n}];"
      },
      "id": "tldr-normalize",
      "name": "Normalize TL;DR Inputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        1200
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Build the TL;DR request: call Gemini 2.5 Pro to generate a direct-answer summary.\nconst OPENROUTER_API_KEY = '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';\nconst TLDR_MODEL = 'google/gemini-2.5-pro';\n\nconst form = $('Normalize TL;DR Inputs').first().json;\n\nconst topicLabel = form.topic || form.focus_keyword || 'the topic';\n\nconst systemPrompt = 'You are a senior content analyst. Given a blog post\\'s topic and its full content, write a TL;DR summary that starts with a direct answer.\\n\\nSTRUCTURE (non-negotiable):\\n1. FIRST LINE: A direct answer to the question/topic.\\n   - If the topic is a question \\u2192 answer it directly (e.g., \\\"Yes, microneedling is effective.\\\")\\n   - If the topic is a statement \\u2192 state the key fact directly (e.g., \\\"Microneedling costs around $200-$350 per session.\\\")\\n2. NEXT 5 LINES: Supporting details that explain, provide context, evidence, and actionable advice.\\n\\nEXAMPLES:\\n- Topic: \\\"Is microneedling effective?\\\"\\n  \\u2192 First line: \\\"Yes, microneedling is effective for improving skin texture and reducing scars.\\\"\\n  \\u2192 Followed by: stats, how it works, timeline, suitability, recommendation\\n\\n- Topic: \\\"How much does microneedling cost?\\\"\\n  \\u2192 First line: \\\"Microneedling costs around $200-$350 per session, depending on the provider.\\\"\\n  \\u2192 Followed by: total investment, at-home vs professional, what\\'s included, discounts, value comparison\\n\\n- Topic: \\\"Best running shoes for beginners\\\"\\n  \\u2192 First line: \\\"The best running shoes for beginners provide cushioning, support, and stability.\\\"\\n  \\u2192 Followed by: top picks, features to consider, price range, common mistakes, final tip\\n\\nRULES:\\n- Start with the direct answer \\u2014 no preamble, no \\\"The answer is...\\\", no hedging\\n- Keep the first line under 20 words\\n- Each supporting sentence must add unique value\\n- Include 1-2 stats or facts from the content\\n- End with what the reader should do or expect\\n- Total: 6 sentences (1 direct answer + 5 supporting)\\n- No fluff, no \\\"In summary\\\" prefaces\\n\\nOUTPUT: Valid JSON only. No markdown code fences. Schema exactly:\\n{\\n  \\\"tldr_summary\\\": \\\"Direct answer followed by 5 supporting sentences.\\\"\\n}';\n\nconst userPrompt = 'TOPIC: ' + topicLabel + '\\n\\nBelow is the full blog post content. Write a TL;DR that starts with a direct answer to the topic, followed by 5 supporting sentences.\\n\\n<content>\\n' + form.content + '\\n</content>\\n\\nReturn the JSON now.';\n\nreturn [{\n  json: {\n    openrouter_api_key: OPENROUTER_API_KEY,\n    openrouter_request: {\n      model: TLDR_MODEL,\n      messages: [\n        { role: 'system', content: systemPrompt },\n        { role: 'user', content: userPrompt }\n      ],\n      temperature: 0.2,\n      max_tokens: 4096,\n      response_format: { type: 'json_object' }\n    },\n    tldr_model: TLDR_MODEL,\n    form\n  }\n}];"
      },
      "id": "tldr-llm-prompt",
      "name": "Generate TL;DR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        1200
      ]
    },
