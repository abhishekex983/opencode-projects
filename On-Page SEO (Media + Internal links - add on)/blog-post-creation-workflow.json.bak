    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Extract query ID from Neuron Writer URL and fetch target word count.\n// Input: { neuronwriter_url: \"https://app.neuronwriter.com/analysis/view/140f29709961c574\" }\n// Output: { target_word_count: 1500 }\n\nconst NEURONWRITER_API_KEY = 'n-737c1202f84e979fa061ad1ad86aceee';\nconst BASE = 'https://app.neuronwriter.com/neuron-api/0.5/writer';\n\nconst input = $input.first().json;\nconst form = (input && typeof input.body === 'object' && input.body !== null && Object.keys(input.body).length > 0)\n  ? input.body\n  : input;\n\nconst url = String(form.neuronwriter_url || form.neuronwriterUrl || form.url || '').trim();\n\nif (!url) {\n  return [{ json: { error: 'neuronwriter_url is required', target_word_count: 0 } }];\n}\n\n// Extract query ID from URL: https://app.neuronwriter.com/analysis/view/140f29709961c574\nconst match = url.match(/\\/view\\/([a-f0-9]+)/i);\nif (!match) {\n  return [{ json: { error: 'Could not extract query ID from URL', target_word_count: 0 } }];\n}\n\nconst queryId = match[1];\n\ntry {\n  const response = await this.helpers.httpRequest({\n    method: 'POST',\n    url: BASE + '/get-query',\n    headers: {\n      'X-API-KEY': NEURONWRITER_API_KEY,\n      'Content-Type': 'application/json',\n      'Accept': 'application/json'\n    },\n    body: { query: queryId },\n    json: true,\n    timeout: 30000\n  });\n\n  if (response.status !== 'ready') {\n    return [{ json: { error: 'Neuron Writer analysis not ready (status: ' + (response.status || 'unknown') + ')', target_word_count: 0 } }];\n  }\n\n  const targetWordCount = response.metrics?.word_count?.target || 0;\n\n  return [{ json: { target_word_count: targetWordCount } }];\n} catch (err) {\n  return [{ json: { error: 'Failed to fetch from Neuron Writer: ' + String(err.message || err).slice(0, 200), target_word_count: 0 } }];\n}"
      },
      "id": "neuron-fetch-wordcount",
      "name": "Fetch Wordcount from Neuron",
