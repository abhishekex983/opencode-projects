    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Normalize inputs for the blog-post-takeaways webhook.\nconst input = $input.first().json;\nconst form = (input && typeof input.body === 'object' && input.body !== null && Object.keys(input.body).length > 0)\n  ? input.body\n  : input;\n\nconst norm = s => String(s).toLowerCase().replace(/[^a-z0-9]/g, '');\nconst pick = (...keys) => {\n  for (const k of keys) {\n    if (form[k] !== undefined && form[k] !== null && form[k] !== '') return form[k];\n  }\n  const targets = keys.map(norm);\n  for (const k of Object.keys(form)) {\n    const n = norm(k);\n    if (targets.some(t => n === t || n.startsWith(t))) return form[k];\n  }\n  return '';\n};\n\nif (!form.content && !form.edited_outline) {\n  return [{ json: { error: 'content is required (the blog post markdown).' } }];\n}\n\nreturn [{\n  json: {\n    topic: pick('topic', 'Topic') || '',\n    focus_keyword: pick('focus_keyword', 'Focus Keyword', 'focusKeyword') || '',\n    content: form.content || form.edited_outline || ''\n  }\n}];"
      },
      "id": "takeaways-normalize",
      "name": "Normalize Takeaways Inputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        1800
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Build the Key Takeaways request: call Gemini 2.5 Pro to generate actionable + summary takeaways.\nconst OPENROUTER_API_KEY = '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';\nconst TAKEAWAYS_MODEL = 'google/gemini-2.5-pro';\n\nconst form = $('Normalize Takeaways Inputs').first().json;\n\nconst topicLabel = form.topic || form.focus_keyword || 'the topic';\n\nconst systemPrompt = 'You are a senior content strategist. Given a blog post\\'s topic and its full content, extract 5-8 key takeaways.\\n\\nMIX (non-negotiable):\\n- Approximately 60% must be ACTIONABLE items (things the reader should do).\\n- Approximately 40% must be INFORMATIONAL summary points (key facts or insights from the article).\\n\\nACTIONABLE takeaways:\\n- Start with a verb (Implement, Use, Avoid, Focus, Prioritize, Invest, Track, etc.).\\n- Be specific: include what to do, how, or why.\\n- Example: \"Implement structured data markup to increase chances of featured snippets.\"\\n\\nINFORMATIONAL takeaways:\\n- State a key fact, trend, or insight from the content.\\n- Use phrases like \"Studies show...\", \"The data indicates...\", \"X is...\", \"Y has been shown to...\".\\n- Example: \"Articles with 1,500+ words consistently outperform shorter content in search rankings.\"\\n\\nRULES:\\n- Each takeaway must be a single sentence, under 25 words.\\n- No vague statements. Every takeaway must be grounded in the content.\\n- Avoid repeating the same point in different words.\\n- Order from most important/foundational to most specific/advanced.\\n- The takeaway_summary must be a 2-3 sentence executive summary of the entire article.\\n\\nOUTPUT: Valid JSON only. No markdown code fences. No prose outside JSON. Schema exactly:\\n{\\n  \"takeaway_summary\": \"A 2-3 sentence executive summary of the article.\",\\n  \"takeaways\": [\\n    { \"type\": \"action\", \"text\": \"Verb-first actionable takeaway.\" },\\n    { \"type\": \"summary\", \"text\": \"Informational summary point.\" }\\n  ]\\n}';\n\nconst userPrompt = 'TOPIC: ' + topicLabel + '\\n\\nBelow is the full blog post content. Extract 5-8 key takeaways (mix of actionable and informational) plus a 2-3 sentence executive summary.\\n\\n<content>\\n' + form.content + '\\n</content>\\n\\nReturn the JSON now.';\n\nreturn [{\n  json: {\n    openrouter_api_key: OPENROUTER_API_KEY,\n    takeaways_model: TAKEAWAYS_MODEL,\n    openrouter_request: {\n      model: TAKEAWAYS_MODEL,\n      messages: [\n        { role: 'system', content: systemPrompt },\n        { role: 'user', content: userPrompt }\n      ],\n      temperature: 0.2,\n      max_tokens: 4096,\n      response_format: { type: 'json_object' }\n    }\n  }\n}];"
      },
      "id": "takeaways-llm-prompt",
      "name": "Generate Key Takeaways",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        1800
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.openrouter_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "HTTP-Referer",
              "value": "https://shettymarketing.com"
            },
            {
              "name": "X-Title",
              "value": "Blog Post Creator :: Key Takeaways (n8n)"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.openrouter_request) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "takeaways-openrouter",
      "name": "OpenRouter (Key Takeaways)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        1800
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Parse the Key Takeaways JSON from the OpenRouter response.\nconst resp = $input.first().json;\nconst payload = $('Generate Key Takeaways').first().json;\n\nif (resp.error) {\n  return [{ json: { error: 'OpenRouter returned error', detail: resp.error } }];\n}\n\nconst text = resp?.choices?.[0]?.message?.content;\nif (!text) {\n  return [{ json: { error: 'No content in OpenRouter response', raw: resp } }];\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(text);\n} catch {\n  const cleaned = text.replace(/^\\`\\`\\`(?:json)?\\\\s*/i, '').replace(/\\\\s*\\`\\`\\`\\\\s*$/i, '').trim();\n  try { parsed = JSON.parse(cleaned); } catch {\n    return [{ json: { error: 'Failed to parse JSON from model', raw_text: text } }];\n  }\n}\n\nconst takeaways = Array.isArray(parsed.takeaways) ? parsed.takeaways : [];\n\nreturn [{ json: {\n  takeaway_summary: parsed.takeaway_summary || '',\n  takeaways: takeaways,\n  model: payload.takeaways_model,\n  usage: resp.usage || null,\n  generated_at: new Date().toISOString()\n} }];"
      },
      "id": "takeaways-parse",
      "name": "Parse Key Takeaways",
      "type": "n8n-nodes-base.code",
