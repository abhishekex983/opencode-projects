    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Fetch writing style instructions from the catalog webhook.\nconst input = $input.first().json;\nconst styleId = input.writing_style || '';\nconst webhookUrl = input.writing_styles_webhook || '';\n\nlet writing_style_instructions = '';\n\nif (styleId && webhookUrl) {\n  try {\n    const resp = await this.helpers.httpRequest({\n      method: 'POST',\n      url: webhookUrl,\n      headers: { 'Content-Type': 'application/json' },\n      body: { test: false },\n      json: true,\n      timeout: 15000\n    });\n\n    if (resp && Array.isArray(resp.styles)) {\n      const match = resp.styles.find(s => s.id === styleId);\n      if (match && match.instructions) {\n        writing_style_instructions = match.instructions;\n      }\n    }\n  } catch (err) {\n    // If fetch fails, continue without style instructions\n  }\n}\n\n// Pass through all input fields plus the fetched instructions\nreturn [{ json: { ...input, writing_style_instructions } }];"
      },
      "id": "outline-fetch-style",
      "name": "Fetch Writing Style (Outline)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        10,
        0
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Fetch writing style instructions from the catalog webhook.\nconst input = $input.first().json;\nconst styleId = input.writing_style || '';\nconst webhookUrl = input.writing_styles_webhook || '';\n\nlet writing_style_instructions = '';\n\nif (styleId && webhookUrl) {\n  try {\n    const resp = await this.helpers.httpRequest({\n      method: 'POST',\n      url: webhookUrl,\n      headers: { 'Content-Type': 'application/json' },\n      body: { test: false },\n      json: true,\n      timeout: 15000\n    });\n\n    if (resp && Array.isArray(resp.styles)) {\n      const match = resp.styles.find(s => s.id === styleId);\n      if (match && match.instructions) {\n        writing_style_instructions = match.instructions;\n      }\n    }\n  } catch (err) {\n    // If fetch fails, continue without style instructions\n  }\n}\n\n// Pass through all input fields plus the fetched instructions\nreturn [{ json: { ...input, writing_style_instructions } }];"
      },
      "id": "content-fetch-style",
      "name": "Fetch Writing Style (Content)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        10,
        600
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// If empathy_enabled, search Exa for reader pain points, objections,\n// and problems from Reddit, forums, YouTube, plus DataForSEO PAA.\n// Then cluster with Gemini Flash into structured empathy themes.\n\nconst OPENROUTER_API_KEY = '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';\nconst EXA_API_KEY = 'b0beb520-610f-4246-ade5-7620631a89aa';\nconst DATAFORSEO_LOGIN = 'abhishekbolarshetty@gmail.com';\nconst DATAFORSEO_PASSWORD = '6aa69ca0a4bf8188';\nconst EMPATHY_MODEL = 'google/gemini-2.5-flash';\n\nconst form = $('Normalize Outline Inputs').first().json;\n\nif (!form.empathy_enabled) {\n  return [{\n    json: {\n      empathy_enabled: false,\n      empathy_block: '',\n      source_count: 0\n    }\n  }];\n}\n\nconst query = (form.topic || form.focus_keyword || '').trim();\nif (!query) {\n  return [{ json: { empathy_enabled: true, empathy_block: '', source_count: 0, error: 'No topic or focus keyword' } }];\n}\n\n// ─── Helper: Exa search + contents ───\nconst exaSearch = async (searchQuery, opts = {}) => {\n  try {\n    const searchResp = await this.helpers.httpRequest({\n      method: 'POST',\n      url: 'https://api.exa.ai/search',\n      headers: { 'x-api-key': EXA_API_KEY, 'Content-Type': 'application/json' },\n      body: {\n        query: searchQuery,\n        numResults: opts.numResults || 8,\n        type: 'neural',\n        useAutoprompt: true,\n        ...(opts.includeDomains ? { includeDomains: opts.includeDomains } : {}),\n        ...(opts.excludeDomains ? { excludeDomains: opts.excludeDomains } : {}),\n        ...(opts.category ? { category: opts.category } : {})\n      },\n      json: true,\n      timeout: 30000\n    });\n\n    if (!searchResp || !Array.isArray(searchResp.results) || searchResp.results.length === 0) {\n      return [];\n    }\n\n    const ids = searchResp.results.map(r => r.id).filter(Boolean);\n    const contentsResp = await this.helpers.httpRequest({\n      method: 'POST',\n      url: 'https://api.exa.ai/contents',\n      headers: { 'x-api-key': EXA_API_KEY, 'Content-Type': 'application/json' },\n      body: { ids, text: { maxCharacters: 4000, includeHtmlTags: false } },\n      json: true,\n      timeout: 30000\n    });\n\n    const textById = new Map();\n    if (contentsResp && Array.isArray(contentsResp.results)) {\n      for (const c of contentsResp.results) {\n        if (c.id && c.text) textById.set(c.id, c.text);\n      }\n    }\n\n    return searchResp.results.map(r => ({\n      title: r.title || '',\n      url: r.url || '',\n      text: textById.get(r.id) || ''\n    })).filter(r => r.text.length > 100);\n  } catch (e) {\n    return [];\n  }\n}\n\n// ─── Helper: DataForSEO PAA ───\nconst fetchPaa = async (keyword) => {\n  try {\n    const auth = 'Basic ' + Buffer.from(DATAFORSEO_LOGIN + ':' + DATAFORSEO_PASSWORD).toString('base64');\n    const resp = await this.helpers.httpRequest({\n      method: 'POST',\n      url: 'https://api.dataforseo.com/v3/serp/google/organic/live/advanced',\n      headers: { 'Authorization': auth, 'Content-Type': 'application/json' },\n      body: [{ keyword, location_name: 'United States', language_code: 'en', device: 'desktop', depth: 20 }],\n      json: true,\n      timeout: 60000\n    });\n\n    const taskResult = resp?.tasks?.[0]?.result?.[0];\n    if (!taskResult) return [];\n    const items = taskResult.items || [];\n    const paaItem = items.find(i => i.type === 'people_also_ask');\n    if (!paaItem || !Array.isArray(paaItem.items)) return [];\n\n    return paaItem.items.slice(0, 10).map(q => {\n      const expanded = Array.isArray(q.expanded_element) && q.expanded_element[0] ? q.expanded_element[0] : null;\n      return {\n        question: q.title || '',\n        answer_snippet: expanded ? (expanded.description || '') : ''\n      };\n    }).filter(q => q.question);\n  } catch (e) {\n    return [];\n  }\n}\n\n// ─── Run all searches in parallel ───\nlet allEvidence = [];\nlet sourceCount = 0;\n\ntry {\n  const [redditResults, forumResults, youtubeResults, paaResults] = await Promise.all([\n    exaSearch(query + ' pain points frustrations problems', {\n      includeDomains: ['reddit.com'],\n      numResults: 8\n    }),\n    exaSearch(query + ' complaints objections alternatives forum discussion', {\n      excludeDomains: ['reddit.com', 'youtube.com', 'youtu.be'],\n      numResults: 8,\n      category: 'social media'\n    }),\n    exaSearch(query + ' review experience issues', {\n      includeDomains: ['youtube.com', 'youtu.be'],\n      numResults: 6\n    }),\n    fetchPaa(query)\n  ]);\n\n  // Build evidence blocks\n  const evidenceParts = [];\n\n  if (redditResults.length > 0) {\n    const block = redditResults.slice(0, 8).map((r, i) => {\n      const excerpt = r.text.replace(/\\s+/g, ' ').trim().slice(0, 800);\n      return '[R' + (i+1) + '] ' + r.title + '\\nURL: ' + r.url + '\\nExcerpt: ' + excerpt;\n    }).join('\\n\\n');\n    evidenceParts.push('=== REDDIT (' + redditResults.length + ' threads) ===\\n' + block);\n    sourceCount += redditResults.length;\n  }\n\n  if (forumResults.length > 0) {\n    const block = forumResults.slice(0, 8).map((r, i) => {\n      const excerpt = r.text.replace(/\\s+/g, ' ').trim().slice(0, 800);\n      return '[F' + (i+1) + '] ' + r.title + '\\nURL: ' + r.url + '\\nExcerpt: ' + excerpt;\n    }).join('\\n\\n');\n    evidenceParts.push('=== FORUMS (' + forumResults.length + ' threads) ===\\n' + block);\n    sourceCount += forumResults.length;\n  }\n\n  if (youtubeResults.length > 0) {\n    const block = youtubeResults.slice(0, 6).map((r, i) => {\n      const excerpt = r.text.replace(/\\s+/g, ' ').trim().slice(0, 600);\n      return '[Y' + (i+1) + '] ' + r.title + '\\nURL: ' + r.url + '\\nExcerpt: ' + excerpt;\n    }).join('\\n\\n');\n    evidenceParts.push('=== YOUTUBE (' + youtubeResults.length + ' videos) ===\\n' + block);\n    sourceCount += youtubeResults.length;\n  }\n\n  if (paaResults.length > 0) {\n    const block = paaResults.map((q, i) => {\n      return '[PAA' + (i+1) + '] ' + q.question + (q.answer_snippet ? '\\nSnippet: ' + q.answer_snippet.slice(0, 300) : '');\n    }).join('\\n\\n');\n    evidenceParts.push('=== PEOPLE ALSO ASK (' + paaResults.length + ' questions) ===\\n' + block);\n  }\n\n  if (evidenceParts.length === 0) {\n    return [{ json: { empathy_enabled: true, empathy_block: '', source_count: 0, error: 'No empathy sources found' } }];\n  }\n\n  const combined = evidenceParts.join('\\n\\n---\\n\\n');\n\n  // ─── LLM clustering ───\n  const systemPrompt = 'You are a senior content strategist analysing audience empathy data for a blog post. Your job: read raw evidence (Reddit threads, forum discussions, YouTube comments, People Also Ask) about ONE topic and extract the reader\\'s emotional and practical landscape.\\n\\n' +\n    'OUTPUT CATEGORIES:\\n' +\n    '1. PAIN POINTS — emotional frustrations, annoyances, things that make the reader\\'s life harder\\n' +\n    '2. OBJECTIONS — reasons they hesitate, doubt, or resist (too expensive, too complicated, tried before and failed)\\n' +\n    '3. PROBLEMS — practical blockers, technical issues, workflow breakdowns\\n' +\n    '4. FEARS — what they\\'re worried about (wasting money, looking foolish, making things worse)\\n\\n' +\n    'RULES:\\n' +\n    '1. Use only the evidence provided. Never invent quotes or claims.\\n' +\n    '2. Every theme must cite at least one evidence ID (e.g. [R3], [F1], [Y2], [PAA4]).\\n' +\n    '3. Produce 4-8 themes total. Larger themes first (more evidence). Drop themes with <2 supporting items unless signal is strong.\\n' +\n    '4. representative_quotes are short verbatim snippets that capture the user emotion. Keep under ~30 words. Include citation ID inline.\\n' +\n    '5. content_angle is one sentence telling the writer how to address this theme on-page.\\n' +\n    '6. Mix categories: aim for at least 1 pain point, 1 objection, 1 problem, 1 fear if evidence supports it.\\n\\n' +\n    'OUTPUT: Valid JSON only. No markdown fences. No prose outside JSON. Schema exactly:\\n' +\n    '{\\n' +\n    '  \"summary\": \"2-3 sentence overview of what the audience is actually struggling with\",\\n' +\n    '  \"themes\": [\\n' +\n    '    {\\n' +\n    '      \"category\": \"pain_point|objection|problem|fear\",\\n' +\n    '      \"title\": \"Short label (max 6 words)\",\\n' +\n    '      \"description\": \"1-2 sentences describing the theme\",\\n' +\n    '      \"content_angle\": \"How the blog post should address this\",\\n' +\n    '      \"quotes\": [{ \"quote\": \"string\", \"cite\": \"R3\" }, ...],\\n' +\n    '      \"evidence_ids\": [\"R3\", \"F1\", ...],\\n' +\n    '      \"weight\": integer 0-100\\n' +\n    '    }\\n' +\n    '  ],\\n' +\n    '  \"notes\": \"one-line note if evidence was thin, else empty string\"\\n' +\n    '}\\n\\n' +\n    'Theme weight is % of total evidence; weights across themes should roughly sum to 100.';\n\n  const userPrompt = 'TOPIC: ' + query + '\\n\\nEVIDENCE BLOCKS (cite items using the [ID] tags):\\n\\n' + combined + '\\n\\nReturn only the JSON object as specified.';\n\n  const llmResp = await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'https://openrouter.ai/api/v1/chat/completions',\n    headers: {\n      'Authorization': 'Bearer ' + OPENROUTER_API_KEY,\n      'Content-Type': 'application/json',\n      'HTTP-Referer': 'https://shettymarketing.com',\n      'X-Title': 'Blog Post Creator :: Empathy Research (n8n)'\n    },\n    body: {\n      model: EMPATHY_MODEL,\n      messages: [\n        { role: 'system', content: systemPrompt },\n        { role: 'user', content: userPrompt }\n      ],\n      temperature: 0.3,\n      response_format: { type: 'json_object' }\n    },\n    json: true,\n    timeout: 90000\n  });\n\n  let empathyBlock = '';\n  const rawContent = llmResp?.choices?.[0]?.message?.content || '';\n\n  try {\n    const parsed = JSON.parse(rawContent.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```\\s*$/i, '').trim());\n    if (parsed.summary) empathyBlock += parsed.summary + '\\n\\n';\n    if (Array.isArray(parsed.themes)) {\n      for (const theme of parsed.themes) {\n        empathyBlock += '**[' + (theme.category || 'insight').toUpperCase() + '] ' + (theme.title || '') + '**\\n';\n        empathyBlock += (theme.description || '') + '\\n';\n        if (theme.content_angle) empathyBlock += 'Content angle: ' + theme.content_angle + '\\n';\n        if (Array.isArray(theme.quotes) && theme.quotes.length > 0) {\n          empathyBlock += 'Reader voices:\\n';\n          for (const q of theme.quotes) {\n            empathyBlock += '- \\\"' + q.quote + '\\\" [' + q.cite + ']\\n';\n          }\n        }\n        empathyBlock += '\\n';\n      }\n    }\n  } catch (e) {\n    empathyBlock = rawContent;\n  }\n\n  return [{\n    json: {\n      empathy_enabled: true,\n      empathy_block: empathyBlock.trim(),\n      source_count: sourceCount,\n      error: null\n    }\n  }];\n\n} catch (err) {\n  return [{\n    json: {\n      empathy_enabled: true,\n      empathy_block: '',\n      source_count: 0,\n      error: 'Empathy research failed: ' + (err.message || String(err))\n    }\n  }];\n}"
      },
      "id": "outline-empathy",
      "name": "Empathy Research",
      "type": "n8n-nodes-base.code",
